<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="dealer-approval" name="经销商订单审批活动图"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="经销商订单审批活动图（基于当前手册及接口的初稿）" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1300" height="45" as="geometry"/></mxCell><mxCell id="sub" value="实线流程为文档/代码可证；橙色注释为待确认的业务分支" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="50" y="65" width="1300" height="25" as="geometry"/></mxCell><mxCell id="lane1" value="经销商 / 云端" style="swimlane;html=1;startSize=36;horizontal=0;fillColor=#F5F8FC;swimlaneFillColor=#FFFFFF;strokeColor=#B8C7D9;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="250" height="800" as="geometry"/></mxCell><mxCell id="lane2" value="区域经理" style="swimlane;html=1;startSize=36;horizontal=0;fillColor=#EFF6FF;swimlaneFillColor=#FFFFFF;strokeColor=#B8C7D9;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="300" height="800" as="geometry"/></mxCell><mxCell id="lane3" value="总部审核 / 订单系统" style="swimlane;html=1;startSize=36;horizontal=0;fillColor=#F0FDF4;swimlaneFillColor=#FFFFFF;strokeColor=#B8C7D9;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="600" y="110" width="450" height="800" as="geometry"/></mxCell><mxCell id="lane4" value="合同 / 后续履行" style="swimlane;html=1;startSize=36;horizontal=0;fillColor=#FFF7ED;swimlaneFillColor=#FFFFFF;strokeColor=#B8C7D9;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1050" y="110" width="400" height="800" as="geometry"/></mxCell>
