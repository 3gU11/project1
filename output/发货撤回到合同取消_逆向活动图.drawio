<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="shipping-reverse" name="发货撤回到合同取消逆向活动图"><mxGraphModel dx="1700" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="发货撤回 → 合同取消（逆向活动图）" style="text;html=1;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="45" y="22" width="1300" height="42" as="geometry"/></mxCell><mxCell id="subtitle" value="按逆向追溯顺序：先撤销最末端发货，再逐层核对机台、销售订单、合同关联，最后由有权限人员单独取消合同" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="45" y="66" width="1500" height="28" as="geometry"/></mxCell><mxCell id="lane1" value="仓库 / 发货复核" style="swimlane;html=1;startSize=36;horizontal=0;fillColor=#EFF6FF;swimlaneFillColor=#FFFFFF;strokeColor=#B8C7D9;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="45" y="112" width="285" height="840" as="geometry"/></mxCell><mxCell id="lane2" value="库存 / 生产机台关联" style="swimlane;html=1;startSize=36;horizontal=0;fillColor=#F0FDF4;swimlaneFillColor=#FFFFFF;strokeColor=#B8C7D9;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="112" width="400" height="840" as="geometry"/></mxCell><mxCell id="lane3" value="销售订单 / 合同关联" style="swimlane;html=1;startSize=36;horizontal=0;fillColor=#FFF7ED;swimlaneFillColor=#FFFFFF;strokeColor=#B8C7D9;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="730" y="112" width="420" height="840" as="geometry"/></mxCell><mxCell id="lane4" value="合同管理 / 沙盘" style="swimlane;html=1;startSize=36;horizontal=0;fillColor=#F5F3FF;swimlaneFillColor=#FFFFFF;strokeColor=#B8C7D9;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1150" y="112" width="470" height="840" as="geometry"/></mxCell>
<mxCell id="start" value="" style="ellipse;html=1;aspect=fixed;fillColor=#17324D;strokeColor=#17324D;" vertex="1" parent="1"><mxGeometry x="164" y="165" width="22" height="22" as="geometry"/></mxCell><mxCell id="ship" value="正式发货已完成\n机台状态：已出库" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#E2E8F0;strokeColor=#64748B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="95" y="215" width="160" height="60" as="geometry"/></mxCell><mxCell id="select" value="选择需撤回的流水号\n核对发货记录及原因" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#4A78A8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="320" width="190" height="62" as="geometry"/></mxCell><mxCell id="d1" value="流水号及影响对象\n核对无误？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D29B23;fontSize=12;" vertex="1" parent="1"><mxGeometry x="128" y="430" width="100" height="82" as="geometry"/></mxCell><mxCell id="stop" value="停止撤回\n补充核对信息" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FEF2F2;strokeColor=#D56B6B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="565" width="150" height="52" as="geometry"/></mxCell><mxCell id="revert" value="执行“发货撤回”\n写入审计记录" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#4A78A8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="670" width="190" height="62" as="geometry"/></mxCell><mxCell id="goods" value="按来源恢复机台\n生产机台 → 待入库\n现货 → 原库存库位\n清除订单/客户/合同占用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#4A78A8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="405" y="320" width="245" height="90" as="geometry"/></mxCell><mxCell id="unit" value="清除 units 上的合同、客户、代理商、sales_id、交期和锁定信息" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#4A78A8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="465" width="275" height="68" as="geometry"/></mxCell><mxCell id="order" value="找出受影响销售订单\n状态退回 active\n（原 ready / allocated / packed / done / shipped）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#4A78A8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="785" y="320" width="310" height="78" as="geometry"/></mxCell><mxCell id="d2" value="订单是否仍关联\n目标合同？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D29B23;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="455" width="115" height="90" as="geometry"/></mxCell><mxCell id="keep" value="保留合同\n只完成发货撤回与订单复核" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#EFF6FF;strokeColor=#4A78A8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="610" width="195" height="60" as="geometry"/></mxCell><mxCell id="check" value="人工核对合同状态、全部关联订单、机台及已发生业务\n确认取消影响范围" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFF7ED;strokeColor=#D29B23;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1205" y="315" width="345" height="76" as="geometry"/></mxCell><mxCell id="d3" value="有权人员确认\n取消合同？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D29B23;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1320" y="440" width="115" height="90" as="geometry"/></mxCell><mxCell id="keep2" value="不取消\n合同保持原状态" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#EFF6FF;strokeColor=#4A78A8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1165" y="610" width="165" height="55" as="geometry"/></mxCell><mxCell id="cancel" value="合同管理单独执行\n状态设为“已取消”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#7856A6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1350" y="605" width="215" height="60" as="geometry"/></mxCell><mxCell id="cleanup" value="清理合同关联排产计划、机台占用、生产队列及急单队列；同步清理沙盘并重算" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#F5F3FF;strokeColor=#7856A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1285" y="735" width="300" height="78" as="geometry"/></mxCell><mxCell id="end" value="撤回链路完成\n合同取消（若确认）" style="ellipse;shape=doubleEllipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#42A16B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1365" y="855" width="150" height="58" as="geometry"/></mxCell><mxCell id="note" value="重要边界：当前代码证明发货撤回会退回库存/机台关联并将销售订单置为 active；不会自动取消合同。取消合同是独立接口与权限动作，且会清理排产/沙盘关联。若已有其他订单、已投产或已履行业务，需先核实影响后再取消。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#D6A943;fontSize=12;size=18;" vertex="1" parent="1"><mxGeometry x="55" y="785" width="1000" height="125" as="geometry"/></mxCell>
<mxCell id="e1" edge="1" parent="1" source="start" target="ship" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#55738F;"/><mxCell id="e2" edge="1" parent="1" source="ship" target="select" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#55738F;"/><mxCell id="e3" edge="1" parent="1" source="select" target="d1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#55738F;"/><mxCell id="e4" value="否" edge="1" parent="1" source="d1" target="stop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#C35656;fontColor=#9E3838;labelBackgroundColor=#FFFFFF;"/><mxCell id="e5" value="是" edge="1" parent="1" source="d1" target="revert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#55738F;fontColor=#267346;labelBackgroundColor=#FFFFFF;"/><mxCell id="e6" edge="1" parent="1" source="revert" target="goods" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#55738F;"/><mxCell id="e7" edge="1" parent="1" source="goods" target="unit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#55738F;"/><mxCell id="e8" edge="1" parent="1" source="unit" target="order" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#55738F;"/><mxCell id="e9" edge="1" parent="1" source="order" target="d2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#55738F;"/><mxCell id="e10" value="否：停止于订单回退" edge="1" parent="1" source="d2" target="keep" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#55738F;fontColor=#334155;labelBackgroundColor=#FFFFFF;"/><mxCell id="e11" value="是：进入独立取消评估" edge="1" parent="1" source="d2" target="check" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D29B23;fontColor=#8A5B00;labelBackgroundColor=#FFFFFF;"/><mxCell id="e12" edge="1" parent="1" source="check" target="d3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#D29B23;"/><mxCell id="e13" value="否" edge="1" parent="1" source="d3" target="keep2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#55738F;fontColor=#334155;labelBackgroundColor=#FFFFFF;"/><mxCell id="e14" value="是" edge="1" parent="1" source="d3" target="cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#7856A6;fontColor=#5B3D87;labelBackgroundColor=#FFFFFF;"/><mxCell id="e15" edge="1" parent="1" source="cancel" target="cleanup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#7856A6;"/><mxCell id="e16" edge="1" parent="1" source="cleanup" target="end" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#7856A6;"/></root></mxGraphModel></diagram></mxfile>
