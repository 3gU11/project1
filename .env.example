# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=030705
MYSQL_DB=rjfinshed

# WeChat Cloud Hosting integration for V7 local client
WECHAT_CLOUD_API_BASE=
V7_API_KEY=
REPAIR_IDENTITY_API_KEY=

# 维修系统每日快照同步（开发阶段保持 false；API 地址由服务器联调时填写）
REPAIR_SYNC_ENABLED=false
REPAIR_SYNC_BASE_URL=
REPAIR_SYNC_SNAPSHOT_PATH=/api/integrations/v8/snapshots
REPAIR_SYNC_CLIENT_ID=v8-factory-01
REPAIR_SYNC_KEY_ID=
REPAIR_SYNC_HMAC_SECRET=
REPAIR_SYNC_MTLS_CERT=
REPAIR_SYNC_MTLS_KEY=
REPAIR_SYNC_CA_BUNDLE=
REPAIR_SYNC_TIME=02:30
REPAIR_SYNC_TIMEZONE=Asia/Shanghai
REPAIR_SYNC_ALLOWED_CHECK_STATUS=manual_passed,passed,approved
REPAIR_SYNC_MAX_BODY_MB=10
REPAIR_SYNC_AUTO_ACTIVATE=true

# PaddleOCR Configuration
PADDLE_OCR_CPU_THREADS=4
PADDLE_OCR_GPU=False

# Performance Optimization Feature Flags
# 设置为 true 启用 TTL 缓存替代 lru_cache(maxsize=1)
USE_TTL_CACHE=false
TTL_CACHE_SECONDS=30

# Security Settings (Coming soon)
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# JWT_EXPIRE_MINUTES=1440
# PASSWORD_HASH_UPGRADE=true
USE_REDIS_CACHE=false
