# Uvicorn runtime
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_RELOAD=false
UVICORN_LOG_LEVEL=info
UVICORN_WORKERS=2

# App auth / bootstrap
ADMIN_PASSWORD=888

# MySQL (optional, keep defaults if not used)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_me
MYSQL_DB=rjfinshed

# WeChat Cloud Hosting integration for V7 local client
WECHAT_CLOUD_API_BASE=
V7_API_KEY=

# 维修系统每日快照同步（开发阶段保持 false）
REPAIR_SYNC_ENABLED=false
REPAIR_SYNC_BASE_URL=
REPAIR_SYNC_SNAPSHOT_PATH=/api/integrations/v8/snapshots
REPAIR_SYNC_CLIENT_ID=v8-factory-01
REPAIR_SYNC_KEY_ID=
REPAIR_SYNC_HMAC_SECRET=
REPAIR_SYNC_MTLS_CERT=
REPAIR_SYNC_MTLS_KEY=
REPAIR_SYNC_CA_BUNDLE=
REPAIR_SYNC_TIME=02:30
REPAIR_SYNC_TIMEZONE=Asia/Shanghai
REPAIR_SYNC_ALLOWED_CHECK_STATUS=manual_passed,passed,approved
REPAIR_SYNC_MAX_BODY_MB=10

# Optional startup behavior
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
USE_REDIS_CACHE=false
